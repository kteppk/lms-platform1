rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function own(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function teacher() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/teachers/$(request.auth.uid));
    }

    match /lectures/{uid}/{fileName} {
      allow get: if request.auth != null;
      allow create: if own(uid) && teacher() &&
        request.resource.size <= 100 * 1024 * 1024 &&
        request.resource.contentType in [
          'application/pdf', 'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'video/mp4', 'text/html'
        ];
      allow delete: if own(uid) && teacher();
    }

    match /books/{uid}/{fileName} {
      allow get: if request.auth != null;
      allow create: if own(uid) && teacher() &&
        request.resource.size <= 100 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
      allow delete: if own(uid) && teacher();
    }

    match /test_answers/{uid}/{fileName} {
      allow get: if own(uid);
    }

    match /test_answers/{uid}/{attemptId}/{fileName} {
      allow get: if own(uid);
      allow create: if own(uid) && !teacher() &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif|avif|bmp|tiff)');
    }
  }
}
